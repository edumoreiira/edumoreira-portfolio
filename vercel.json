{
  "version": 2,
  "builds": [
    {
      "src": "dist/edumoreira-portfolio/server/server.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "dist/edumoreira-portfolio/browser/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "dist/edumoreira-portfolio/server/server.mjs"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "dist/edumoreira-portfolio/browser/index.html"
    }
  ]
}